#include <winres.h>
#pragma code_page(65001)
#include "resource.h"
#include "version.hpp"

IDI_APP ICON "upplayer.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION UPPLAYER_VERSION_MAJOR,UPPLAYER_VERSION_MINOR,UPPLAYER_VERSION_PATCH,0
PRODUCTVERSION UPPLAYER_VERSION_MAJOR,UPPLAYER_VERSION_MINOR,UPPLAYER_VERSION_PATCH,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "upPlayer"
            VALUE "FileDescription", "upPlayer"
            VALUE "FileVersion", UPPLAYER_VERSION_STRING
            VALUE "InternalName", "upPlayer"
            VALUE "LegalCopyright", "Copyright (c) 2026 Felix"
            VALUE "OriginalFilename", "upPlayer.exe"
            VALUE "ProductName", "upPlayer"
            VALUE "ProductVersion", UPPLAYER_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

IDD_URL DIALOGEX 0, 0, 380, 92
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Open Network Address"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Address(&A):", -1, 8, 12, 48, 10
    COMBOBOX IDC_URL, 58, 10, 314, 120, CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    CONTROL "low-latency", IDC_LOW_LATENCY, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 58, 32, 120, 12
    PUSHBUTTON "Remove", IDC_URL_REMOVE, 58, 50, 50, 14
    DEFPUSHBUTTON "OK", IDOK, 260, 72, 50, 14
    PUSHBUTTON "Cancel", IDCANCEL, 316, 72, 50, 14
    PUSHBUTTON "Clear list", IDC_URL_CLEAR, 8, 72, 60, 14
END

IDD_WHISPER_MODEL DIALOGEX 0, 0, 420, 168
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "upPlayer - Whisper Model"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "", IDC_WHISPER_SUMMARY, 12, 8, 396, 32
    LTEXT "", IDC_WHISPER_FILE, 12, 42, 396, 10
    LTEXT "Model directory (click to copy):", -1, 12, 58, 300, 10
    LTEXT "", IDC_WHISPER_DIR, 12, 70, 300, 14, SS_LEFT | SS_NOTIFY | SS_NOPREFIX | SS_PATHELLIPSIS
    PUSHBUTTON "Open folder", IDC_WHISPER_OPEN_DIR, 320, 68, 88, 16
    LTEXT "Hugging Face download URL (click to copy):", -1, 12, 90, 396, 10
    LTEXT "", IDC_WHISPER_URL, 12, 102, 396, 24, SS_LEFT | SS_NOTIFY | SS_NOPREFIX
    LTEXT "Save the .bin into the model directory, then pick Whisper Model again.", -1, 12, 122, 396, 12
    DEFPUSHBUTTON "OK", IDOK, 358, 142, 50, 14
END

IDD_SETTINGS DIALOGEX 0, 0, 360, 148
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "upPlayer - Settings"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Whisper model:", -1, 12, 14, 80, 10
    COMBOBOX IDC_SETTINGS_MODEL, 100, 12, 248, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Caption language:", -1, 12, 36, 80, 10
    COMBOBOX IDC_SETTINGS_LANG, 100, 34, 248, 160, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL "Prefer low-latency for network streams", IDC_SETTINGS_LOW_LATENCY, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 58, 220, 12
    LTEXT "Recent URLs to keep:", -1, 12, 80, 100, 10
    EDITTEXT IDC_SETTINGS_RECENT_COUNT, 120, 78, 40, 14, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "(1-20)", -1, 168, 80, 40, 10
    DEFPUSHBUTTON "OK", IDOK, 244, 118, 50, 14
    PUSHBUTTON "Cancel", IDCANCEL, 300, 118, 50, 14
END

IDC_ACCEL ACCELERATORS
BEGIN
    "O", ID_FILE_OPEN, VIRTKEY, CONTROL
    "U", ID_FILE_OPEN_URL, VIRTKEY, CONTROL
    VK_SPACE, ID_PLAY_PAUSE, VIRTKEY
    VK_LEFT, ID_SEEK_BACK, VIRTKEY
    VK_RIGHT, ID_SEEK_FORWARD, VIRTKEY
    VK_UP, ID_VOLUME_UP, VIRTKEY
    VK_DOWN, ID_VOLUME_DOWN, VIRTKEY
    VK_UP, ID_SPEED_UP, VIRTKEY, CONTROL
    VK_DOWN, ID_SPEED_DOWN, VIRTKEY, CONTROL
    VK_BACK, ID_SPEED_RESET, VIRTKEY
    "1", ID_SIZE_05, VIRTKEY
    "2", ID_SIZE_10, VIRTKEY
    "3", ID_SIZE_15, VIRTKEY
    "4", ID_SIZE_20, VIRTKEY
    "5", ID_FULLSCREEN_NORMAL, VIRTKEY
    "6", ID_FULLSCREEN_STRETCH, VIRTKEY
    VK_NUMPAD1, ID_SIZE_05, VIRTKEY
    VK_NUMPAD2, ID_SIZE_10, VIRTKEY
    VK_NUMPAD3, ID_SIZE_15, VIRTKEY
    VK_NUMPAD4, ID_SIZE_20, VIRTKEY
    VK_NUMPAD5, ID_FULLSCREEN_NORMAL, VIRTKEY
    VK_NUMPAD6, ID_FULLSCREEN_STRETCH, VIRTKEY
    "i", ID_STATS_SHOW
    "I", ID_STATS_TOGGLE
    "m", ID_VOLUME_MUTE
    "M", ID_VOLUME_MUTE
    VK_VOLUME_DOWN, ID_VOLUME_DOWN, VIRTKEY
    VK_VOLUME_UP, ID_VOLUME_UP, VIRTKEY
    VK_VOLUME_MUTE, ID_VOLUME_MUTE, VIRTKEY
    "s", ID_SNAPSHOT
    "S", ID_SNAPSHOT
    "z", ID_CLIP_MARK_IN
    "Z", ID_CLIP_MARK_IN
    "x", ID_CLIP_MARK_OUT
    "X", ID_CLIP_MARK_OUT
    "c", ID_CLIP_EXPORT
    "C", ID_CLIP_EXPORT
    "a", ID_CAPTIONS_TOGGLE
    "A", ID_CAPTIONS_TOGGLE
    ",", ID_FRAME_BACK
    ".", ID_FRAME_FORWARD
    VK_OEM_COMMA, ID_FRAME_BACK, VIRTKEY
    VK_OEM_PERIOD, ID_FRAME_FORWARD, VIRTKEY
    VK_ESCAPE, ID_ESCAPE, VIRTKEY
    VK_RETURN, ID_FULLSCREEN_TOGGLE, VIRTKEY
END
