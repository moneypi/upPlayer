#include <winres.h>
#pragma code_page(65001)
#include "resource.h"

IDI_APP ICON "upplayer.ico"

IDD_URL DIALOGEX 0, 0, 380, 72
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Open Network Address"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Address(&A):", -1, 8, 12, 48, 10
    EDITTEXT IDC_URL, 58, 10, 314, 14, ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL "--profile=low-latency", IDC_LOW_LATENCY, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 58, 32, 140, 12
    CONTROL "--untimed", IDC_UNTIMED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 206, 32, 80, 12
    DEFPUSHBUTTON "OK", IDOK, 260, 52, 50, 14
    PUSHBUTTON "Cancel", IDCANCEL, 316, 52, 50, 14
END

IDC_ACCEL ACCELERATORS
BEGIN
    "O", ID_FILE_OPEN, VIRTKEY, CONTROL
    "U", ID_FILE_OPEN_URL, VIRTKEY, CONTROL
    VK_SPACE, ID_PLAY_PAUSE, VIRTKEY
    VK_LEFT, ID_SEEK_BACK, VIRTKEY
    VK_RIGHT, ID_SEEK_FORWARD, VIRTKEY
    VK_UP, ID_VOLUME_UP, VIRTKEY
    VK_DOWN, ID_VOLUME_DOWN, VIRTKEY
    "[", ID_SPEED_DOWN
    "]", ID_SPEED_UP
    0xDB, ID_SPEED_DOWN, VIRTKEY
    0xDD, ID_SPEED_UP, VIRTKEY
    VK_BACK, ID_SPEED_RESET, VIRTKEY
    "1", ID_SIZE_05, VIRTKEY
    "2", ID_SIZE_10, VIRTKEY
    "3", ID_SIZE_15, VIRTKEY
    "4", ID_SIZE_20, VIRTKEY
    "5", ID_FULLSCREEN_NORMAL, VIRTKEY
    "6", ID_FULLSCREEN_STRETCH, VIRTKEY
    VK_NUMPAD1, ID_SIZE_05, VIRTKEY
    VK_NUMPAD2, ID_SIZE_10, VIRTKEY
    VK_NUMPAD3, ID_SIZE_15, VIRTKEY
    VK_NUMPAD4, ID_SIZE_20, VIRTKEY
    VK_NUMPAD5, ID_FULLSCREEN_NORMAL, VIRTKEY
    VK_NUMPAD6, ID_FULLSCREEN_STRETCH, VIRTKEY
    "i", ID_STATS_SHOW
    "I", ID_STATS_TOGGLE
    "m", ID_VOLUME_MUTE
    "M", ID_VOLUME_MUTE
    VK_VOLUME_DOWN, ID_VOLUME_DOWN, VIRTKEY
    VK_VOLUME_UP, ID_VOLUME_UP, VIRTKEY
    VK_VOLUME_MUTE, ID_VOLUME_MUTE, VIRTKEY
    "s", ID_SNAPSHOT
    "S", ID_SNAPSHOT
    "z", ID_CLIP_MARK_IN
    "Z", ID_CLIP_MARK_IN
    "x", ID_CLIP_MARK_OUT
    "X", ID_CLIP_MARK_OUT
    "c", ID_CLIP_EXPORT
    "C", ID_CLIP_EXPORT
    ",", ID_FRAME_BACK
    ".", ID_FRAME_FORWARD
    VK_OEM_COMMA, ID_FRAME_BACK, VIRTKEY
    VK_OEM_PERIOD, ID_FRAME_FORWARD, VIRTKEY
    VK_ESCAPE, ID_ESCAPE, VIRTKEY
    VK_RETURN, ID_FULLSCREEN_TOGGLE, VIRTKEY
END
